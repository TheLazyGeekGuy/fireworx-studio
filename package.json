{
  "name": "fireworx-studio",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "FireworX Editor: browser editor and librarian for the FireworX, built on MIDI Studio.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "modules:generate": "node scripts/generate-editor-registrations.mjs",
    "manual:generate": "node scripts/generate-fireworx-manual.mjs",
    "prebuild": "npm run modules:generate && node scripts/generate-fireworx-manual.mjs --check",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build && node scripts/verify-distribution.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tests/run.mjs",
    "leak-gate": "node scripts/leak-gate.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheLazyGeekGuy/fireworx-studio.git"
  },
  "homepage": "https://thelazygeekguy.github.io/fireworx-studio/",
  "type": "module"
}
